# Copy to .env (git ignores it) and fill in. Only the Anthropic key is
# needed, and only for the chat. docs/CONFIG.md lists every setting.

# Your Anthropic API key, for the chat with Claude.
ANTHROPIC_API_KEY=

# Optional. The defaults are shown.
# WOODCHUCK_PORT=8905
# WOODCHUCK_WEB_PORT=8906
# WOODCHUCK_DATA_DIR=data
# WOODCHUCK_MODEL=claude-sonnet-5-5

# Optional: GitHub, for filing missing tools as issues and sharing approved
# parts as pull requests. It stays off until you name a repository, and what
# it creates there is public if the repository is. It needs the gh command
# line tool, signed in. docs/CONFIG.md has more.
# WOODCHUCK_REPO=owner/name

# Optional: the AI blend in photo mode uses OpenAI's image edit API.
# Each blend sends the placed photo to OpenAI and costs money.
# OPENAI_API_KEY=
# WOODCHUCK_IMAGE_MODEL=gpt-image-2.5-sunburst

# Optional: your own tailnet, behind the owner lock.
# docs/REMOTE_ACCESS.md has the steps.
# WOODCHUCK_TRUSTED_HOSTS=my-mac.my-tailnet.ts.net
